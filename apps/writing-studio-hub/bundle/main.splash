let WarmCard = RoundedView{width: Fill height: Fit flow: Down padding: 24 spacing: 12 draw_bg.color: warm draw_bg.border_size: 1.0 draw_bg.border_color: linec draw_bg.border_radius: 20.0}

let Btn = ButtonFlat{height: 40 width: Fit padding: Inset{left: 18 right: 18} draw_bg +: {color: #xffffff color_hover: warm color_down: #xefefea border_size: 1.0 border_color: ink border_radius: 20.0} draw_text +: {color: ink color_hover: ink color_down: ink text_style: theme.font_bold{font_size: 12}}}
let BtnPrimary = ButtonFlat{height: 48 width: Fill padding: Inset{left: 20 right: 20} draw_bg +: {color: ink color_hover: #x252525 color_down: #x363636 border_size: 0.0 border_radius: 24.0} draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: theme.font_bold{font_size: 13}}}
let BtnSmall = ButtonFlat{height: 30 width: Fit padding: Inset{left: 12 right: 12} draw_bg +: {color: #xffffff color_hover: warm color_down: #xefefea border_size: 1.0 border_color: linec border_radius: 15.0} draw_text +: {color: ink color_hover: ink color_down: ink text_style: theme.font_regular{font_size: 11}}}

let LineInput = TextInput{width: Fill height: 44 padding: Inset{left: 14 right: 14 top: 12 bottom: 12} draw_bg +: {color: #xffffff color_hover: #xffffff color_focus: #xffffff color_empty: #xffffff border_size: 1.0 border_color: linec border_color_focus: ink border_radius: 12.0} draw_text +: {color: ink color_hover: ink color_focus: ink text_style: theme.font_regular{font_size: 14}} draw_cursor +: {color: ink}}

let BadgeReady = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 3} draw_bg.color: ink draw_bg.border_radius: 9.0
    txt := Label{text: "待审阅" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 10}}}
let BadgeApplied = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 3} draw_bg.color: #xffffff draw_bg.border_size: 1.0 draw_bg.border_color: ink draw_bg.border_radius: 9.0
    txt := Label{text: "已应用" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 10}}}
let BadgeMuted = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 3} draw_bg.color: #x00000000 draw_bg.border_radius: 9.0
    txt := Label{text: "" draw_text.color: faint draw_text.text_style: theme.font_bold{font_size: 10}}}
let BadgeFailed = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 3} draw_bg.color: #x00000000 draw_bg.border_radius: 9.0
    txt := Label{text: "失败" draw_text.color: red draw_text.text_style: theme.font_bold{font_size: 10}}}

SolidView{width: Fill height: Fill flow: Down draw_bg.color: #xffffff

    // ---------- 顶栏 ----------
    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} padding: Inset{left: 24 right: 24 top: 14 bottom: 14} spacing: 10
        Label{width: Fit height: Fit text: "写作工作室" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
        page_label := MetaL{}
        Filler{}
        engine_status := MetaL{text: ""}
    }
    Hr{}

    // ---------- 01 文库 ----------
    library := ScrollYView{width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14 on_render: || {
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "01 / 文库"}
        TitleL{text: "草稿箱"}
        BodyL{text: "选择一篇文档，在其中选中段落，请求一次由你掌控的改写。"}
        BtnPrimary{text: "新建文档" on_click: || new_document()}
        Btn{width: Fill text: "从图文工作室拉回" on_click: || show_page("import")}
        if docs.len() == 0 {
            BodyL{text: "还没有文档，点「新建文档」开始。"}
        }
        for i d in docs {
            RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 8 margin: Inset{bottom: 4} draw_bg.color: #xffffff draw_bg.border_size: 1.0 draw_bg.border_color: linec draw_bg.border_radius: 16.0
                View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 6
                    Label{width: Fill height: Fit text: d.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14.5}}
                    BtnSmall{text: "打开" on_click: || open_doc(d.id)}
                    BtnSmall{text: "排版" on_click: || send_article_by_id(d.id)}
                    BtnSmall{text: "删除" on_click: || ask_delete_doc(d.id)}
                }
                BodyL{text: doc_preview(d, 40) draw_text.text_style: theme.font_regular{font_size: 12}}
                MetaL{text: "" + d.paragraphs.len() + " 段 · v" + d.version + " · 最后编辑 " + fmt_time(d.modified)}
                Hr{}
                let ts = tasks_of(d.id)
                let total = ts.len()
                let open = 0
                for t in ts { if t.status == "ready" || t.status == "preparing" { open += 1 } }
                let shown = 0
                let j = total - 1
                while j >= 0 && shown < 3 {
                    let t = ts[j]
                    GestureView{width: Fill height: Fit on_tap: |x, y| open_task_line(d.id, t.id)
                        View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8 padding: Inset{top: 5 bottom: 5}
                            if t.status == "ready" { BadgeReady{} }
                            else if t.status == "applied" { BadgeApplied{} }
                            else if t.status == "failed" { BadgeFailed{} }
                            else if t.status == "preparing" { BadgeMuted{txt.text: "准备中"} }
                            else if t.status == "expired" { BadgeMuted{txt.text: "已过期"} }
                            else { BadgeMuted{txt.text: "已放弃"} }
                            Label{width: Fit height: Fit text: t.request draw_text.color: #x101010cc draw_text.text_style: theme.font_regular{font_size: 12}}
                            Filler{}
                            MetaL{text: fmt_time(t.created_at)}
                        }
                    }
                    shown += 1
                    j -= 1
                }
                if total == 0 { MetaL{text: "暂无任务"} }
                else if total > 3 { MetaL{text: "" + total + " 条任务 · " + open + " 条待审阅"} }
            }
        }
    }}

    // ---------- 02 起草 ----------
    edit := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        Btn{width: Fit text: "← 返回文库" on_click: || back_library()}
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "01 / 起草"}
        doc_title := LineInput{empty_text: "未命名文档" on_change: |text| title_edited(text)}
        RoundedView{width: Fill height: 260 padding: 0 draw_bg.color: warm draw_bg.border_size: 1.0 draw_bg.border_color: linec draw_bg.border_radius: 20.0
            doc_body := TextInput{width: Fill height: Fill is_multiline: true empty_text: "写下你的文章…（段落之间空一行）" padding: Inset{left: 20 right: 20 top: 20 bottom: 20} on_change: |text| body_edited(text)
                draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000 border_size: 0.0}
                draw_text +: {color: ink color_hover: ink color_focus: ink text_style: theme.font_regular{font_size: 15 line_spacing: 1.6}}
                draw_cursor +: {color: ink}}
        }
        MetaL{text: "点选要改写的段落（对应原生版的「选中文字」）："}
        para_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            let d = doc_by_id(cur_doc)
            if d != nil {
                for i p in d.paragraphs {
                    if p.trim() != "" {
                        if i == sel_para {
                            GestureView{width: Fill height: Fit on_tap: |x, y| select_para(i)
                                RoundedView{width: Fill height: Fit padding: 12 draw_bg.color: ink draw_bg.border_radius: 10.0
                                    Label{width: Fill height: Fit text: "第 " + (i + 1) + " 段 · " + take_chars(p.trim(), 24) draw_text.color: #xffffff draw_text.text_style: theme.font_regular{font_size: 12}}}
                            }
                        } else {
                            GestureView{width: Fill height: Fit on_tap: |x, y| select_para(i)
                                RoundedView{width: Fill height: Fit padding: 12 draw_bg.color: warm draw_bg.border_radius: 10.0
                                    Label{width: Fill height: Fit text: "第 " + (i + 1) + " 段 · " + take_chars(p.trim(), 24) draw_text.color: ink draw_text.text_style: theme.font_regular{font_size: 12}}}
                            }
                        }
                    }
                }
            }
        }}
        View{width: Fill height: Fit flow: Right spacing: 10
            toggle_concise := Btn{text: "更简洁" height: 36 on_click: || toggle_constraint("concise")}
            toggle_formal := Btn{text: "更正式" height: 36 on_click: || toggle_constraint("formal")}
            toggle_citations := Btn{text: "保留引用" height: 36 on_click: || toggle_constraint("citations")}
        }
        request_input := LineInput{empty_text: "描述改写要求，例如：写得更简洁…"}
        BtnPrimary{text: "请求改写" on_click: || request_rewrite()}
        Hr{}
        StageL{text: "任务历史"}
        edit_tasks := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            let ts = tasks_of(cur_doc)
            if ts.len() == 0 { MetaL{text: "暂无任务"} }
            let j = ts.len() - 1
            while j >= 0 {
                let t = ts[j]
                RoundedView{width: Fill height: Fit flow: Down padding: 14 spacing: 6 draw_bg.color: #xffffff draw_bg.border_size: 1.0 draw_bg.border_color: linec draw_bg.border_radius: 12.0
                    View{width: Fill height: Fit flow: Right align: Align{y: 0.5} spacing: 8
                        Label{width: Fill height: Fit text: status_label(t.status) + " · " + t.request draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5}}
                        BtnSmall{text: "打开" on_click: || open_task(t.id)}
                        BtnSmall{text: "删除" on_click: || ask_delete_task(t.id)}
                    }
                    MetaL{text: "第 " + (t.para_index + 1) + " 段 · " + take_chars(t.text_snapshot, 40) + " · " + fmt_time(t.created_at)}
                }
                j -= 1
            }
        }}
    }

    // ---------- 03 审阅 ----------
    review := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "02 / 审阅"}
        TitleL{text: "对照改写提案"}
        BodyL{text: "审阅并可直接修改这份改写提案。"}
        prep_card := WarmCard{visible: false
            StageL{text: "准备中…"}
            BodyL{text: "较长的草稿正在后台准备；提案就绪后此卡片会自动更新。"}
            prep_engine := MetaL{text: ""}
        }
        fail_card := Card{visible: false
            StageL{text: "失败"}
            fail_reason := BodyL{text: ""}
            Btn{width: Fill text: "重试" on_click: || retry_task()}
        }
        expired_card := WarmCard{visible: false
            StageL{text: "已过期"}
            BodyL{text: "提案可能已过期；请基于最新文档重新生成。"}
            Btn{width: Fill text: "重新生成" on_click: || regen_task()}
        }
        compare_box := View{visible: false width: Fill height: Fit flow: Down spacing: 14
            View{width: Fill height: Fit flow: Right spacing: 20
                WarmCard{width: Fill padding: 18 spacing: 10
                    MetaL{text: "原文"}
                    review_original := TextL{draw_text.color: sub}
                }
                Card{width: Fill padding: 18 spacing: 4
                    MetaL{text: "提案（可编辑）"}
                    View{width: Fill height: 160
                        review_proposal := TextInput{width: Fill height: Fill is_multiline: true padding: Inset{left: 0 right: 0 top: 10 bottom: 0} on_change: |text| proposal_edited(text)
                            draw_bg +: {color: #x00000000 color_hover: #x00000000 color_focus: #x00000000 color_empty: #x00000000 border_size: 0.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink text_style: theme.font_regular{font_size: 13.5 line_spacing: 1.6}}
                            draw_cursor +: {color: ink}}
                    }
                }
            }
            citations_line := MetaL{text: "" width: Fill}
            Card{padding: 18 spacing: 8
                MetaL{text: "改动"}
                diff_adds := Label{width: Fill height: Fit draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 12.5 line_spacing: 1.5}}
                diff_dels := Label{width: Fill height: Fit draw_text.color: faint draw_text.text_style: theme.font_regular{font_size: 12.5 line_spacing: 1.5}}
            }
            BtnPrimary{text: "继续确认" on_click: || goto_confirm()}
        }
        Btn{width: Fill text: "放弃改写" on_click: || discard_task()}
    }

    // ---------- 04 确认 ----------
    confirm := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "03 / 确认"}
        TitleL{text: "确认这次修改"}
        BodyL{text: "将把这次改写应用到选中的段落。"}
        Card{
            MetaL{text: "目标 · 选中段落"}
            confirm_target := BodyL{text: ""}
            Hr{}
            MetaL{text: "其他段落 · 不变"}
            MetaL{text: "操作 · 应用审阅后的改写"}
        }
        Btn{width: Fill text: "查看修改后的文档" on_click: || toggle_preview()}
        preview_card := WarmCard{visible: false
            confirm_preview := TextL{draw_text.color: sub}
        }
        BtnPrimary{text: "应用" on_click: || apply_now()}
        Btn{width: Fill text: "放弃" on_click: || discard_task()}
    }

    // ---------- 05 完成 ----------
    done := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "04 / 完成"}
        TitleL{text: "改写已应用"}
        BodyL{text: "文档已使用你审阅过的措辞；发布仍是独立的操作。"}
        Btn{width: Fill text: "撤销" on_click: || undo_now()}
        BtnPrimary{text: "发布" on_click: || show_page("publish")}
        Btn{width: Fill text: "返回文档" on_click: || show_page("edit")}
    }

    // ---------- 06 发布 ----------
    publish := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        MetaL{text: "W R I T I N G   A T E L I E R"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "05 / 发布"}
        TitleL{text: "发布"}
        BodyL{text: "发布与应用互不影响。选择一个目的地；执行前需要单独确认。"}
        Btn{width: Fill height: 48 text: "发布到当前聊天" on_click: || choose_dest("chat")}
        Btn{width: Fill height: 48 text: "文章编辑器 · 图文工作室" on_click: || choose_dest("article")}
        Btn{width: Fill height: 48 text: "导出为文件" on_click: || choose_dest("file")}
        Btn{width: Fill height: 48 text: "分享链接（演示）" on_click: || choose_dest("link")}
        publish_box := WarmCard{visible: false
            publish_label := BodyL{text: ""}
            BtnPrimary{text: "确认目的地" on_click: || publish_confirm()}
        }
        Btn{width: Fill text: "返回文档" on_click: || show_page("edit")}
    }

    // ---------- 图文工作室拉回 ----------
    import_page := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 24 right: 24 top: 22 bottom: 16} spacing: 14
        MetaL{text: "A R T I C L E   S T U D I O"}
        SolidView{width: 92 height: 1 draw_bg.color: linec}
        StageL{text: "拉回到写作"}
        TitleL{text: "图文库"}
        BodyL{text: "选择一篇排版草稿拉回继续改写；版本会按来源自动对齐。"}
        Btn{width: Fill text: "返回文库" on_click: || show_page("library")}
        import_list := View{width: Fill height: Fit flow: Down spacing: 8 on_render: || {
            if articles.len() == 0 {
                BodyL{text: "图文库为空。先在文库卡片点「排版」或在发布页选择图文工作室。"}
            }
            let j = articles.len() - 1
            while j >= 0 {
                let a = articles[j]
                GestureView{width: Fill height: Fit on_tap: |x, y| import_article(a.id)
                    RoundedView{width: Fill height: Fit flow: Down padding: 18 spacing: 6 draw_bg.color: #xffffff draw_bg.border_size: 1.0 draw_bg.border_color: linec draw_bg.border_radius: 16.0
                        Label{width: Fill height: Fit text: a.title draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 14.5}}
                        MetaL{text: "图文工作室 · " + fmt_time(a.modified)}
                    }
                }
                j -= 1
            }
        }}
    }

    // ---------- 删除确认 ----------
    delete_page := ScrollYView{visible: false width: Fill height: Fill flow: Down padding: Inset{left: 32 right: 32 top: 60 bottom: 32} spacing: 14
        Card{
            delete_title := StageL{text: "删除？" draw_text.text_style: theme.font_bold{font_size: 16 line_spacing: 1.25}}
            delete_body := BodyL{text: ""}
            View{width: Fill height: Fit flow: Right spacing: 12
                Btn{width: Fill text: "取消" on_click: || cancel_delete()}
                BtnPrimary{width: Fill text: "删除" on_click: || confirm_delete()}
            }
        }
    }

    // ---------- 状态栏 ----------
    View{width: Fill height: Fit flow: Down padding: Inset{left: 24 right: 24 top: 8 bottom: 12} spacing: 8
        Hr{}
        status_label := Label{width: Fill height: Fit text: "" draw_text.color: sub draw_text.text_style: theme.font_regular{font_size: 11 line_spacing: 1.3}}
    }
}
